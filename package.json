{
  "name": "groundswell",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "atlas": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/build-atlas.ts",
    "launch": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/launch.ts",
    "benchmark": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/benchmark.ts",
    "calibrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/calibrate.ts",
    "record": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/record-showcases.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@deck.gl/core": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/react": "9.4.0",
    "@groundswell/sim": "*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "maplibre-gl": "6.15.0",
    "next": "15.5.28",
    "ngeohash": "0.6.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-map-gl": "8.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  }
}
